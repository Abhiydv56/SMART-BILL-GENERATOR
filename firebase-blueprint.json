{
  "entities": {
    "User": {
      "path": "/users/{userId}",
      "description": "User profile document for shop owners and cashiers",
      "fields": {
        "email": { "type": "string", "description": "Email address of the user" },
        "displayName": { "type": "string", "description": "Display name of the shop owner" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "shopName": { "type": "string", "description": "Name of the owner's retail shop" },
        "role": { "type": "string", "description": "User role: owner or cashier" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" }
      }
    },
    "Shop": {
      "path": "/shops/{shopId}",
      "description": "Shop profile and business configuration",
      "fields": {
        "ownerId": { "type": "string", "description": "UID of the shop owner" },
        "name": { "type": "string", "description": "Shop or Mall business name" },
        "tagline": { "type": "string", "description": "Tagline or slogan" },
        "mode": { "type": "string", "description": "small_shop or mall" },
        "address": { "type": "string", "description": "Shop address line" },
        "city": { "type": "string", "description": "City" },
        "state": { "type": "string", "description": "State" },
        "pincode": { "type": "string", "description": "PIN code" },
        "phone": { "type": "string", "description": "Shop contact number" },
        "email": { "type": "string", "description": "Shop email address" },
        "gstin": { "type": "string", "description": "GSTIN number" },
        "upiId": { "type": "string", "description": "UPI ID for QR payments" },
        "invoicePrefix": { "type": "string", "description": "Invoice number prefix" },
        "currentInvoiceNum": { "type": "number", "description": "Running invoice sequence" }
      }
    },
    "Product": {
      "path": "/shops/{shopId}/products/{productId}",
      "description": "Inventory product item owned by the shop",
      "fields": {
        "name": { "type": "string", "description": "Product name" },
        "category": { "type": "string", "description": "Product category" },
        "price": { "type": "number", "description": "Selling price inclusive of GST" },
        "gstRate": { "type": "number", "description": "GST percentage" },
        "stock": { "type": "number", "description": "Available stock quantity" },
        "minStockAlert": { "type": "number", "description": "Low stock threshold alert" },
        "barcode": { "type": "string", "description": "EAN / UPC / custom barcode" },
        "sku": { "type": "string", "description": "Stock keeping unit" },
        "unit": { "type": "string", "description": "Unit of measurement" }
      }
    },
    "Bill": {
      "path": "/shops/{shopId}/bills/{billId}",
      "description": "Sales invoice generated by this shop",
      "fields": {
        "invoiceNumber": { "type": "string", "description": "Formatted invoice number" },
        "date": { "type": "string", "description": "Invoice ISO date" },
        "timestamp": { "type": "number", "description": "Epoch timestamp" },
        "customerName": { "type": "string", "description": "Customer name" },
        "customerPhone": { "type": "string", "description": "Customer phone" },
        "grandTotal": { "type": "number", "description": "Final bill amount in INR" },
        "paymentMethod": { "type": "string", "description": "cash, upi, card, or split" },
        "cashierName": { "type": "string", "description": "Cashier who billed" }
      }
    },
    "CustomerLoyalty": {
      "path": "/shops/{shopId}/customers/{customerId}",
      "description": "Customer loyalty balance and history for this shop",
      "fields": {
        "phone": { "type": "string", "description": "Customer phone number" },
        "name": { "type": "string", "description": "Customer name" },
        "points": { "type": "number", "description": "Active redeemable loyalty points" },
        "totalSpent": { "type": "number", "description": "Lifetime amount spent in INR" },
        "billsCount": { "type": "number", "description": "Total visits/bills count" },
        "tier": { "type": "string", "description": "Loyalty tier: Bronze, Silver, Gold, Platinum" }
      }
    },
    "Cashier": {
      "path": "/shops/{shopId}/cashiers/{cashierId}",
      "description": "Counter / billing operator profiles for this shop",
      "fields": {
        "name": { "type": "string", "description": "Cashier operator name" },
        "counterName": { "type": "string", "description": "Assigned counter / terminal name" },
        "role": { "type": "string", "description": "admin or cashier" }
      }
    },
    "Department": {
      "path": "/shops/{shopId}/departments/{departmentId}",
      "description": "Mall / store departments for this shop",
      "fields": {
        "name": { "type": "string", "description": "Department name" },
        "nameHi": { "type": "string", "description": "Hindi department name" },
        "code": { "type": "string", "description": "Department code" }
      }
    },
    "LoyaltyConfig": {
      "path": "/shops/{shopId}/loyaltyConfig/{configId}",
      "description": "Loyalty program settings for this shop",
      "fields": {
        "enabled": { "type": "boolean", "description": "Whether loyalty points are active" },
        "spendPerPoint": { "type": "number", "description": "Rupees spent per 1 point" },
        "pointValueINR": { "type": "number", "description": "INR redemption value per point" },
        "minPointsToRedeem": { "type": "number", "description": "Minimum points required to redeem" },
        "maxDiscountPercent": { "type": "number", "description": "Max discount % of bill via points" }
      }
    }
  }
}
